---
import '../styles/global.css';
import '../styles/motion.css';
import { content, type Lang } from '../content/site';
import { LANG_PATHS, LANG_ROUTES, withBase, absolute } from '../lib/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const canonical = absolute(LANG_ROUTES[lang]);
const ogImage = absolute('ryuichi-og.jpg');
const isRoot = lang === 'es';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0e1013" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f1ea" media="(prefers-color-scheme: light)" />
    <link rel="canonical" href={canonical} />
    {Object.entries(LANG_ROUTES).map(([code, route]) => <link rel="alternate" hreflang={code} href={absolute(route)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(LANG_ROUTES.es)} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:locale" content={{ es: 'es_PE', en: 'en_US', ja: 'ja_JP' }[lang]} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="preload" as="image" href={withBase('art/sumi.webp')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+JP:wght@400;500&family=Shippori+Mincho:wght@500;700&display=swap"
      rel="stylesheet"
    />
    {
      /* Tema: se decide antes de pintar para que no haya parpadeo. Prioridad: elección guardada > preferencia del sistema. */
    }
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved === 'light' || saved === 'dark' ? saved : matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    {
      /* Movimiento: se decide antes de pintar qué coreografía toca (ver src/styles/motion.css).
         .motion = hay JS y no se pidió reducir movimiento; .intro = primera visita de la sesión (telón);
         .quick = se viene de otra página del sitio (cambio de idioma), sin entrada del hero. */
    }
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        var internal = false;
        var seen = true;
        try {
          internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
        } catch (e) {}
        try {
          if (sessionStorage.getItem('redirected')) {
            sessionStorage.removeItem('redirected');
            internal = false;
          }
          seen = sessionStorage.getItem('intro') === '1';
          sessionStorage.setItem('intro', '1');
        } catch (e) {}
        if (internal) d.classList.add('quick');
        else if (!seen) d.classList.add('intro');
        // Si el módulo de movimiento no llega a cargar, no se deja nada oculto.
        setTimeout(function () {
          if (!window.__motion) d.classList.remove('motion', 'intro');
        }, 4000);
      })();
    </script>
    {
      /* En la raíz: si el visitante llega desde fuera y ya eligió otro idioma (o su navegador está en EN/JA),
         se le envía a esa versión antes de pintar nada. Navegar dentro del sitio nunca redirige. */
      isRoot && (
        <script is:inline define:vars={{ paths: LANG_PATHS }}>
          (function () {
            try {
              var ref = document.referrer;
              var internal = ref && new URL(ref).origin === location.origin;
              if (internal) return;
              var saved = localStorage.getItem('lang');
              var nav = (navigator.language || '').slice(0, 2);
              var pick = saved || nav;
              if ((pick === 'en' || pick === 'ja') && paths[pick]) {
                // La página de destino debe tratarse como primera visita, no como navegación interna.
                sessionStorage.removeItem('intro');
                sessionStorage.setItem('redirected', '1');
                location.replace(paths[pick]);
              }
            } catch (e) {}
          })();
        </script>
      )
    }
    <script is:inline define:vars={{ lang }}>
      try {
        localStorage.setItem('lang', lang);
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    {
      /* Al cambiar de idioma se vuelve a la misma altura de lectura, antes del primer pintado. */
    }
    <script is:inline>
      (function () {
        try {
          var keep = sessionStorage.getItem('keep-scroll');
          if (keep === null) return;
          sessionStorage.removeItem('keep-scroll');
          var max = document.documentElement.scrollHeight - innerHeight;
          if (max > 0 && +keep > 0) scrollTo({ top: +keep * max, behavior: 'instant' });
        } catch (e) {}
      })();
    </script>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
